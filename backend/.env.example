# Copy to .env and replace placeholder values.
# Never commit real secrets or a filled-in .env file.

APP_NAME=ORVIA API
APP_ENV=development
DEBUG=true

# PostgreSQL (matches docker-compose.yml defaults). Local only.
# Hosted demo/production must use Render's Internal Database URL, never this host.
DATABASE_URL=postgresql+psycopg://orvia:orvia@localhost:5433/orvia

# Pytest uses a separate database so TRUNCATE never wipes app data.
# Create once: docker exec orvia-postgres psql -U orvia -d postgres -c "CREATE DATABASE orvia_test OWNER orvia;"
# Then: DATABASE_URL=.../orvia_test alembic upgrade head
# TEST_DATABASE_URL=postgresql+psycopg://orvia:orvia@localhost:5433/orvia_test

# Generate a long random string for hosted/production (32+ characters).
# APP_ENV=production and APP_ENV=demo refuse this example value and other weak secrets.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Comma-separated browser origins allowed to call this API.
# Hosted demo and production refuse wildcard (*) origins.
# Local Vite:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Cloudflare Pages example (exact origin, no wildcard):
# CORS_ORIGINS=https://orvia-saas-platform.pages.dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional demo tenant. Never runs unless DEMO_SEED_ENABLED=true.
# APP_ENV=production always refuses this flag.
# APP_ENV=demo allows it only when email and password are also set.
# Creates the user/org only if the email does not already exist. Never overwrites data.
DEMO_SEED_ENABLED=false
# DEMO_SEED_EMAIL=demo@orvia.app
# DEMO_SEED_PASSWORD=replace-with-a-10-plus-char-password
# DEMO_SEED_ORG_NAME=ORVIA Demo

# Invitation lifetime in hours. Raw invitation tokens are hashed at rest and are
# not returned in API responses. Acceptance uses the raw token delivered out of band.
INVITATION_EXPIRE_HOURS=168

# Email delivery. "logging" records messages locally and does not send.
# Use EMAIL_PROVIDER=smtp only when SMTP_HOST and SMTP_FROM are configured.
# Never commit real SMTP passwords.
EMAIL_PROVIDER=logging
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_FROM_EMAIL=noreply@localhost
SMTP_FROM_NAME=ORVIA
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=0
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=50
OUTBOX_PROCESSING_TIMEOUT_SECONDS=300
OUTBOX_MAX_ATTEMPTS=3
OUTBOX_RETRY_BASE_SECONDS=10

# Object storage. "memory" is for tests/local/free demo without MinIO or AWS.
# Production (APP_ENV=production) requires STORAGE_PROVIDER=s3, EMAIL_PROVIDER=smtp,
# DEBUG=false, and a strong JWT_SECRET. The API will refuse to start otherwise.
# Free hosted demo (APP_ENV=demo) may keep logging email + memory storage.
# MinIO (optional): docker compose --profile storage up -d
STORAGE_PROVIDER=memory
# Public base URL embedded in memory signed upload/download URLs.
# Local: http://127.0.0.1:8000
# Render demo: https://<service>.onrender.com
MEMORY_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8000
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
POD_UPLOAD_URL_TTL_SECONDS=300
POD_DOWNLOAD_URL_TTL_SECONDS=120
POD_SIGNATURE_MAX_BYTES=2000000
POD_PHOTO_MAX_BYTES=8000000
POD_EVIDENCE_PENDING_TTL_SECONDS=86400
POD_EVIDENCE_CLEANUP_ENABLED=true
POD_EVIDENCE_CLEANUP_INTERVAL_SECONDS=3600
POD_EVIDENCE_CLEANUP_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# Free hosted demo on Render (do not commit real values)
# See FREE_DEMO_DEPLOYMENT.md. Paste these into the Render dashboard only.
#
# APP_ENV=demo
# DEBUG=false
# DATABASE_URL=<Render Internal Database URL>
# JWT_SECRET=<32+ character random secret>
# CORS_ORIGINS=https://<project>.pages.dev
# EMAIL_PROVIDER=logging
# STORAGE_PROVIDER=memory
# MEMORY_STORAGE_PUBLIC_BASE_URL=https://<service>.onrender.com
# DEMO_SEED_ENABLED=true
# DEMO_SEED_EMAIL=demo@orvia.app
# DEMO_SEED_PASSWORD=<at least 10 characters>
# DEMO_SEED_ORG_NAME=ORVIA Demo
# -----------------------------------------------------------------------------
