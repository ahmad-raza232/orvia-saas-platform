# Legacy customer portal (booking compatibility only). Do not use for ORVIA /app.
VITE_API_URL=https://goburq.com/api

# ORVIA tenant SaaS API (FastAPI /api/v1).
# Local Vite: keep /api/v1 so the Vite proxy forwards to the backend (see vite.config.js).
# Cloudflare Pages / hosted demo: set the public Render origin, for example:
#   VITE_TENANT_API_URL=https://<service>.onrender.com/api/v1
# If a reverse proxy serves the SPA and API on the same host, keep /api/v1.
# Never bake localhost or 127.0.0.1 into a production build.
VITE_TENANT_API_URL=/api/v1
