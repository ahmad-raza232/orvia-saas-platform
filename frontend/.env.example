# Legacy customer portal (booking / public tracking). Do not rename.
VITE_API_URL=https://goburq.com/api

# Softorica Modules 1–11 tenant SaaS API (FastAPI).
# Must point at the local/backend process that serves /api/v1/shipments, etc.
# Do NOT point this at https://goburq.com/api.
VITE_TENANT_API_URL=http://127.0.0.1:8000/api/v1

# Backend CORS must include your Vite origin, e.g.:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174
